{
  "resolve_intent": {
    "type": "object",
    "properties": {
      "reason": { "type": "string", "description": "One sentence: why this intent" },
      "intent": { "type": "string", "enum": ["build", "explain", "clarify"] },
      "goal": {
        "type": "string",
        "description": "What the user wants from this turn, in one self-contained sentence"
      },
      "questions": {
        "type": "array",
        "description": "Only for clarify: short questions. Empty otherwise.",
        "items": {
          "type": "object",
          "properties": {
            "question": { "type": "string" },
            "options": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Two to four short suggested answers, or empty"
            },
            "multiple": {
              "type": "boolean",
              "description": "True if more than one option can apply at once; false if they are alternatives"
            }
          },
          "required": ["question", "options", "multiple"],
          "additionalProperties": false
        }
      }
    },
    "required": ["reason", "intent", "goal", "questions"],
    "additionalProperties": false
  },
  "planner": {
    "type": "object",
    "properties": {
      "reason": { "type": "string", "description": "One sentence: the approach" },
      "steps": {
        "type": "array",
        "items": { "type": "string" },
        "description": "The edits to make, in order, one per step"
      }
    },
    "required": ["reason", "steps"],
    "additionalProperties": false
  },
  "reviewer": {
    "type": "object",
    "properties": {
      "reason": { "type": "string", "description": "One sentence: why this verdict" },
      "ok": { "type": "boolean" },
      "issues": {
        "type": "array",
        "items": { "type": "string" },
        "description": "What's wrong and where, one per item. Empty when ok."
      }
    },
    "required": ["reason", "ok", "issues"],
    "additionalProperties": false
  }
}
